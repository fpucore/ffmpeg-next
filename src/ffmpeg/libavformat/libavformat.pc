prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: libavformat
Description: FFmpeg container format library
Version: 63.5.101
Requires: 
Requires.private: libavcodec >= 63.7.100, libswresample >= 7.2.100, libavutil >= 61.5.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm -lxml2 -lbz2 -ldvdnav -ldvdread -lmodplug -lopenmpt -lstdc++ -lbluray -lgmp -lz -latomic -lgnutls -lcurl -lsrt -lssh -lzmq
Cflags: -I${includedir}
