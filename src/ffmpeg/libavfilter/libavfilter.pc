prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 12.3.101
Requires: 
Requires.private: libswscale >= 10.2.100, libavformat >= 63.5.101, libavcodec >= 63.7.100, libswresample >= 7.2.100, libavutil >= 61.5.100
Conflicts:
Libs: -L${libdir}  -lavfilter 
Libs.private: -pthread -lm -latomic -lz -lbs2b -lrubberband -lfftw3 -lsamplerate -lstdc++ -lharfbuzz -lfribidi -llcms2 -lplacebo -lvmaf -lass -lva -lvidstab -lm -fopenmp -lzmq -lzimg -lOpenCL -lfontconfig -lfreetype -L/usr/lib/pkgconfig/../ -lvpl -ldl
Cflags: -I${includedir}
