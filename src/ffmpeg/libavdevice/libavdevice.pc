prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: libavdevice
Description: FFmpeg device handling library
Version: 63.2.100
Requires: 
Requires.private: libavfilter >= 12.3.101, libswscale >= 10.2.100, libavformat >= 63.5.101, libavcodec >= 63.7.100, libswresample >= 7.2.100, libavutil >= 61.5.100
Conflicts:
Libs: -L${libdir}  -lavdevice 
Libs.private: -lm -latomic -lraw1394 -lavc1394 -lrom1394 -liec61883 -ljack -ldrm -lxcb -lxcb-shm -lxcb-shape -lxcb-xfixes -lasound -lpulse -pthread -lsndio -lv4l2 -lXv -lX11 -lXext
Cflags: -I${includedir}
