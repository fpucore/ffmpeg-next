# Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA

# Start installation procedures
say "[H-Linux] > Orchestrating ffmpeg-next Compile & Install procedures."; and say "Working... "

sayln

say "[H-Linux] > Applying version schema."; and say "Applying... "
# Version corrections
copy-dev version-configs/*.c src/ffmpeg/fftools/

sayln

say "[H-Linux] > Compiling ffmpeg-next."; and say "Compiling... "
# Build and Install

# Use ccache
export PATH="/usr/lib/ccache/bin:$PATH"

# Options summary
# -s sync dep, -e keep src, -f force pkg, -i install
makepkg --skippgpcheck --skipchecksums -sefi

sayln

# Check install
if [ $? -eq 0 ]; then
    say "[H-Linux] > Installation of ffmpeg-next successful."
fi
